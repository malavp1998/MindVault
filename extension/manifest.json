{
    "manifest_version": 3,
    "name": "MindVault — AI Second Brain",
    "version": "1.2",
    "description": "Save any webpage to your AI-powered knowledge vault. Search, relate, and rediscover your saved notes using semantic AI.",
    "permissions": [
        "activeTab",
        "storage",
        "scripting",
        "tabs"
    ],
    "host_permissions": [
        "https://mindvault-wspy.onrender.com/*",
        "https://mind-vault-ecru.vercel.app/*",
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://music.youtube.com/*",
        "https://youtu.be/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "*://*.youtube.com/watch*",
                "*://*.youtube.com/shorts/*",
                "*://youtu.be/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}