# Database
POSTGRES_USER=mindvault
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=mindvault
DATABASE_URL=postgresql+asyncpg://mindvault:your_secure_password@localhost:5432/mindvault

# Firebase
VITE_FIREBASE_API_KEY=your_firebase_api_key
# Embedding Provider: "jina"
EMBEDDING_PROVIDER=jina

# LLM Provider: "groq"
LLM_PROVIDER=groq

# Groq (for Multilingual English Routing)
GROQ_API_KEY=your_groq_api_key

# Sarvam (for Multilingual Indic Routing)
SARVAM_API_KEY=your_sarvam_api_key

# Jina AI (for Embeddings)
JINA_API_KEY=your_jina_key

# App
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
RECLUSTER_EVERY_N=20
CHAT_COMPRESSION_THRESHOLD=6000

# LangSmith Monitoring (optional)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=MindVault
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
