# Database
DATABASE_URL=postgresql+asyncpg://***REMOVED***@localhost:5432/mindvault

# Embedding Provider: "openai" or "ollama"
EMBEDDING_PROVIDER=openai

# LLM Provider: "openai" or "ollama"
LLM_PROVIDER=openai

# OpenAI
